# cartridge.conf
# PC Cartridge System — per-cartridge configuration file
#
# Place this file at the root of your cartridge SSD alongside launch.ps1 / launch.sh
#
# ----- Keys -----
#
# executable  (required)
#   What to run when the cartridge is inserted.
#   Can be:
#     - A URI handled by the OS (steam://, heroic://, gog://, epic://, lutris://, http://, ...)
#     - A relative path to a file on the cartridge (e.g. Game\bin\game.exe on Windows,
#       Game/bin/game.sh on Linux)
#
# title  (optional)
#   Human-readable name of the game / content on the cartridge.
#   Shown in log output and (if applicable) in any Tauri UI.
#
# cover  (optional)
#   Relative path to a cover image on the cartridge (PNG, JPG, WEBP).
#   Used by Tauri frontends that display a game card on insert.
#
# ----- Examples -----

# Steam game via URI
executable=steam://rungameid/1091500
title=Cyberpunk 2077
cover=cover.png

# Heroic launcher (GOG / Epic)
# executable=heroic://launch/gog/1207658921

# Local game executable (Windows)
# executable=Game\bin\MyGame.exe

# Local game script (Linux)
# executable=Game/bin/start.sh
